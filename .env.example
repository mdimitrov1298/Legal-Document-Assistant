# === Application ===
APP_ENV=local
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text

# === Ollama (local LLM only, no cloud APIs for case document data) ===
# Terminal A:  ollama serve
# Terminal B:  ollama pull s_emanuilov/BgGPT-v1.0:9b
#              (low-memory fallback: ollama pull qwen2.5:7b)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=s_emanuilov/BgGPT-v1.0:9b
# Fallback for machines with less memory: OLLAMA_MODEL=qwen2.5:7b
# Control model used in the evaluation: llama3.1:8b
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.0
OLLAMA_STUB_ON_UNAVAILABLE=true
OLLAMA_HEALTH_TIMEOUT=3.0
OLLAMA_GENERATE_TIMEOUT=120.0

# === Language-based model routing (off by default) ===
# When MODEL_ROUTING=language, the pipeline picks the model by answer language:
#   BG → OLLAMA_MODEL_BG, EN → OLLAMA_MODEL_EN, other → OLLAMA_MODEL.
# When off, OLLAMA_MODEL is used for all languages.
MODEL_ROUTING=off
OLLAMA_MODEL_BG=s_emanuilov/BgGPT-v1.0:9b
OLLAMA_MODEL_EN=qwen2.5:7b
# Tip: set OLLAMA_MAX_LOADED_MODELS=1 in the Ollama server environment so
# it unloads the previous model before loading the next one (saves RAM).

# === Embeddings ===
# Default: sentence-transformers MiniLM on CPU (ingest works without Ollama)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
# Optional Ollama embeddings (requires: ollama pull nomic-embed-text):
# EMBEDDING_BACKEND=ollama
# EMBEDDING_MODEL=nomic-embed-text
# CI / offline stub:
# EMBEDDING_BACKEND=hash_stub
# EMBEDDING_MODEL=hash_stub

# === Retrieval ===
CHUNK_SIZE=800
CHUNK_OVERLAP=120
SUMMARIZE_TOP_K=8
VERIFY_TOP_K=5

# === Uploads ===
MAX_UPLOAD_MB=20

# === Local storage (gitignored) ===
DATA_DIR=./data
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./data/uploads

# === API ===
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
