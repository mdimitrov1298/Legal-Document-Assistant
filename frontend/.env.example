# Copy to .env.local to override. Vite only exposes variables prefixed with VITE_.

# Full API base URL including the version prefix. When unset the app calls the
# same-origin path /api/v1, which the Vite dev server (and nginx in the
# container) proxies to the backend on port 8000.
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
